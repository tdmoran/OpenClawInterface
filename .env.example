# OpenClaw Gateway Configuration
# WebSocket URL the browser uses to connect to the gateway
NEXT_PUBLIC_GATEWAY_URL=ws://localhost:18789
# Auth token for the gateway connection
NEXT_PUBLIC_GATEWAY_TOKEN=your-token-here

# Server-side proxy URL for the /gateway-ws rewrite (local dev only).
# On Vercel this is unused — the client connects directly via NEXT_PUBLIC_GATEWAY_URL.
# GATEWAY_PROXY_URL=http://localhost:18789
